{
  "name": "further-maths-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "db:up": "docker compose up -d && node db/wait-for-db.mjs",
    "db:down": "docker compose down",
    "db:migrate": "node db/migrate.mjs",
    "db:seed": "node db/seed.mjs",
    "db:reset": "node db/reset.mjs && node db/migrate.mjs && node db/seed.mjs",
    "check:invariants": "node scripts/check-invariants.mjs",
    "demo:walkthrough": "node scripts/walkthrough.mjs",
    "demo:classroom": "node scripts/classroom-walkthrough.mjs",
    "demo:regrade": "node scripts/regrade-demo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "katex": "^0.16.11",
    "next": "^15.1.6",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3"
  }
}
